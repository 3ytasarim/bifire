// Bifire — premium şömine sitesi veri modeli.
// Bağlantı URL'si prisma.config.ts'te (CLI) ve src/lib/db.ts'te (uygulama, adapter-pg) tanımlıdır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enum'lar ─────────────────────────────

enum AdminRole {
  SUPERADMIN
  ADMIN
  EDITOR
}

/// Şömine yakıt / çalışma sistemi.
enum FuelType {
  WOOD
  GAS
  ELECTRIC
  BIOETHANOL
  PELLET
  CHARCOAL
  NONE
}

/// Şömine camının kaç taraftan görüldüğü (sektörde "L tipi", "U tipi", "tünel" diye anılır).
enum ViewType {
  SINGLE
  CORNER_LEFT
  CORNER_RIGHT
  THREE_SIDED
  TUNNEL
  PANORAMIC
  ROUND
}

enum TextPosition {
  LEFT
  CENTER
  RIGHT
  BOTTOM_LEFT
}

enum RequestType {
  CONTACT
  QUOTE
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  QUOTED
  WON
  LOST
  CLOSED
}

// ───────────────────────────── Yönetim ─────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions Session[]
}

model Session {
  id          String   @id @default(cuid())
  adminUserId String
  /// Sadece token'ın SHA-256 özeti saklanır; ham token yalnızca httpOnly cookie'de.
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Başarısız giriş denemeleri (brute-force koruması). Anahtar: e-posta veya IP özeti.
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Tek satırlık site ayarları (id = "site").
model SiteSetting {
  id                 String   @id @default("site")
  companyName        String   @default("Bifire")
  logoUrl            String?
  faviconUrl         String?
  phone              String?
  whatsapp           String?
  whatsappMessage    String?
  email              String?
  address            String?
  mapsUrl            String?
  mapsEmbedUrl       String?
  workingHours       String?
  instagramUrl       String?
  facebookUrl        String?
  youtubeUrl         String?
  linkedinUrl        String?
  pinterestUrl       String?
  footerDescription  String?
  defaultOgImage     String?
  /// Ana sayfa "Bifire" manifesto bölümü görseli.
  aboutImage         String?
  aboutImageAlt      String?
  /// Manifesto görselinin altındaki görünür açıklama (ör. ürün/model adı).
  aboutImageCaption  String?
  /// Ana sayfa "Mimari Ateş Çözümleri" büyük görseli.
  featureImage       String?
  featureImageAlt    String?
  updatedAt          DateTime @updatedAt
}

/// Statik sayfaların SEO bilgileri (Ana Sayfa, Kurumsal, Ürünler, Projeler, Blog, İletişim...).
model SeoPage {
  id             String   @id @default(cuid())
  /// Sabit anahtar: "home", "kurumsal", "urunler", "projeler", "blog", "iletisim", "teklif-al"...
  key            String   @unique
  label          String
  title          String?
  description    String?
  keywords       String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean  @default(true)
  robotsFollow   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Redirect {
  id              String   @id @default(cuid())
  sourcePath      String   @unique
  destinationPath String
  statusCode      Int      @default(301)
  active          Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

/// Merkezi medya kütüphanesi. Dosya diskte/kovada, burada yalnızca meta veri.
model Media {
  id           String   @id @default(cuid())
  url          String   @unique
  storageKey   String   @unique
  filename     String
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// ───────────────────────────── Ana sayfa slider ─────────────────────────────

model HeroSlide {
  id                String       @id @default(cuid())
  desktopImage      String
  mobileImage       String?
  imageAlt          String?
  eyebrow           String?
  title             String
  description       String?
  ctaText           String?
  ctaUrl            String?
  secondaryCtaText  String?
  secondaryCtaUrl   String?
  textPosition      TextPosition @default(LEFT)
  /// Karartma yüzdesi (0–90).
  overlay           Int          @default(45)
  sortOrder         Int          @default(0)
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([active, sortOrder])
}

// ───────────────────────────── Ürünler ─────────────────────────────

model ProductCategory {
  id              String   @id @default(cuid())
  parentId        String?
  name            String
  slug            String   @unique
  /// Kısa tanıtım (kategori hero'su altında).
  description     String?
  /// Ürün listesinin altındaki SEO içeriği (zengin metin, sanitize edilmiş HTML).
  content         String?
  image           String?
  imageAlt        String?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Alt kategorisi olan kategori silinemez (Restrict) — yanlışlıkla bütün ağaç kaybolmasın.
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
  requests ContactRequest[]

  @@index([parentId])
  @@index([active, sortOrder])
}

model Product {
  id               String    @id @default(cuid())
  categoryId       String
  name             String
  slug             String    @unique
  /// Model kodu (ör. "BF-900 L").
  modelCode        String?
  /// Ürünün markası (Bifire veya ithal marka). Boşsa Product şemasında brand yazılmaz.
  brand            String?
  shortDescription String?
  description      String?
  coverImage       String?
  coverImageAlt    String?

  // Filtrelenebilir temel teknik alanlar (hepsi opsiyonel — her şömine türünde anlamlı değil).
  fuelType         FuelType?
  viewType         ViewType?
  powerKw          Decimal?  @db.Decimal(6, 2)
  /// Isıtma kapasitesi, metin olarak ("80–120 m²") — üreticiler aralık veriyor.
  heatingArea      String?
  efficiency       Decimal?  @db.Decimal(5, 2)
  widthMm          Int?
  heightMm         Int?
  depthMm          Int?
  weightKg         Decimal?  @db.Decimal(7, 2)
  flueDiameterMm   Int?
  /// Serbest biçimli ölçü notu ("Cam: 90 × 45 cm").
  dimensionsNote   String?

  featured         Boolean   @default(false)
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)

  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  canonicalUrl     String?
  ogImage          String?
  noIndex          Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Kategori silinirken içinde ürün varsa engellenir (Restrict) — ürünler asla kaskadla silinmez.
  category       ProductCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  specifications ProductSpecification[]
  features       ProductFeature[]
  documents      ProductDocument[]
  tags           ProductTag[]
  projects       Project[]              @relation("ProjectProducts")
  blogPosts      BlogPost[]             @relation("BlogPostProducts")
  requests       ContactRequest[]

  @@index([categoryId])
  @@index([active, sortOrder])
  @@index([featured])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Esnek teknik özellik satırları (farklı şömine türlerinin farklı özellikleri olabilir).
model ProductSpecification {
  id        String  @id @default(cuid())
  productId String
  /// Opsiyonel grup başlığı ("Performans", "Ölçüler", "Malzeme").
  group     String?
  label     String
  value     String
  unit      String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// Madde madde ürün özellikleri ("Asansörlü kapak", "Seramik cam 750 °C").
model ProductFeature {
  id        String @id @default(cuid())
  productId String
  text      String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

/// PDF katalog, teknik çizim, montaj kılavuzu.
model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  title     String
  url       String
  mimeType  String
  size      Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

// ───────────────────────────── Projeler ─────────────────────────────

model Project {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  location         String?
  projectType      String?
  shortDescription String?
  content          String?
  coverImage       String?
  coverImageAlt    String?
  completedAt      DateTime?
  featured         Boolean   @default(false)
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)

  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?
  canonicalUrl     String?
  ogImage          String?
  noIndex          Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  images   ProjectImage[]
  /// Projede kullanılan ürünler (iç linkleme).
  products Product[]      @relation("ProjectProducts")

  @@index([active, sortOrder])
  @@index([featured])
}

model ProjectImage {
  id        String   @id @default(cuid())
  projectId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

// ───────────────────────────── Blog ─────────────────────────────

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String?
  coverImage      String?
  coverImageAlt   String?
  author          String?
  published       Boolean   @default(false)
  featured        Boolean   @default(false)
  publishedAt     DateTime?

  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  canonicalUrl    String?
  ogImage         String?
  noIndex         Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tags     BlogTag[]
  /// Yazıda önerilen ürünler (iç linkleme).
  products Product[] @relation("BlogPostProducts")

  @@index([published, publishedAt])
  @@index([featured])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts BlogPost[]
}

// ───────────────────────────── Talepler ─────────────────────────────

model ContactRequest {
  id          String        @id @default(cuid())
  type        RequestType   @default(CONTACT)
  name        String
  phone       String?
  email       String?
  message     String?
  productId   String?
  categoryId  String?
  /// Talep geldiği anda seçilen ürün/kategori adı (kayıt sonradan silinse de talepte okunur kalsın).
  productName  String?
  categoryName String?
  /// Formun gönderildiği sayfa (ör. /urun/bf-900).
  sourcePath  String?
  kvkkConsent Boolean       @default(false)
  consentAt   DateTime?
  isRead      Boolean       @default(false)
  status      RequestStatus @default(NEW)
  adminNote   String?
  /// IP'nin tuzlu özeti (spam/rate-limit için; ham IP saklanmaz).
  ipHash      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([isRead])
  @@index([createdAt])
  @@index([ipHash, createdAt])
}
