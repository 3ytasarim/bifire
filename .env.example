# ─── Veritabanı (Neon PostgreSQL) ───────────────────────────────────────────
# Uygulama (pooled — host'ta "-pooler" var)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
# Prisma migration (direct — host'ta "-pooler" YOK)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# ─── Site ───────────────────────────────────────────────────────────────────
# Kanonik adres: canonical, sitemap, robots, OG ve JSON-LD buradan üretilir.
# Production'da https zorunlu (ör. https://www.bifiresomine.com). Değişirse yeniden build gerekir.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Yalnızca yerelde production build denemek için (canlıda KULLANMAYIN):
# SITE_URL_ALLOW_INSECURE=1

# ─── Yüklemeler ────────────────────────────────────────────────────────────
# Yüklenen görseller/dokümanlar (varsayılan ./storage/uploads). Sunucuda kalıcı bir diske yönlendirin.
# UPLOAD_DIR="/var/lib/bifire/uploads"

# ─── Güvenlik ──────────────────────────────────────────────────────────────
# Form/giriş rate limit için IP özetinde kullanılan tuz (rastgele, uzun bir değer).
IP_HASH_SALT="degistirin-rastgele-uzun-bir-deger"

# ─── İlk yönetici (yalnızca `npm run admin:create` sırasında okunur) ───────
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# CRM dış kanal kayıt kapısı (POST /api/v1/crm/leads, Authorization: Bearer ...). En az 24 karakter rastgele değer; boşsa kapalı.
CRM_INTAKE_TOKEN=
