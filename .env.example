# Neon PostgreSQL — uygulama (pooled, host'ta "-pooler" var)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
# Neon PostgreSQL — Prisma migration (direct, host'ta "-pooler" YOK)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Sitenin kanonik adresi (production'da https zorunlu)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Upload: "local" (Hetzner diski) | "s3"
STORAGE_PROVIDER="local"

# İlk admin (sadece seed sırasında okunur)
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
